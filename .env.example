# KalaNidhi payments gateway - environment.
# Copy to .env and fill in real values. Never commit .env.

# --- HTTP -------------------------------------------------------------------
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# --- Durable state ----------------------------------------------------------
# SQLite file. Parent directories are created on boot.
STORE_PATH=./data/kalanidhi-payments.sqlite

# 32+ random bytes, base64/hex/passphrase. Keep it in a secret manager, NOT on
# the volume that holds the SQLite database.
SESSION_VAULT_PASSPHRASE=replace-with-at-least-12-random-characters

# --- GoPay / GoBiz ----------------------------------------------------------
GOPAY_MERCHANT_ID=G000000000
# The merchant outlet's static QRIS payload (the long 000201... EMV string from
# the GoBiz dashboard). This placeholder is deliberately not a valid payload.
GOPAY_STATIC_QRIS=replace-with-the-real-static-qris-payload-from-gobiz
# --- Private API authentication ---------------------------------------------
# At least 24 characters. Sent as `x-internal-key`; never in a query string.
INTERNAL_API_KEY=replace-with-a-random-32-byte-key

# --- Webhooks (gateway -> KalaNidhi) ----------------------------------------
WEBHOOK_URL=https://kalanidhi.example.com/api/payments/webhook
# At least 16 bytes, 32 random bytes recommended.
WEBHOOK_SECRET=replace-with-a-random-32-byte-secret

# Defaults are safe for production. Enable these only for a local receiver.
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_TIMEOUT_MS=5000
# Total delivery attempts before the event is dead-lettered.
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BASE_DELAY_MS=1000
WEBHOOK_MAX_DELAY_MS=60000

# --- Reconciliation ---------------------------------------------------------
RECONCILE_INTERVAL_MS=15000
RECONCILE_JITTER_RATIO=0.2
# Tolerance for provider clock/feed indexing. Keep NTP healthy.
CLOCK_SKEW_MS=60000
DEFAULT_EXPIRY_SECONDS=600
MAX_UNIQUE_OFFSET=999
